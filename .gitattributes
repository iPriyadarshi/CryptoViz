# Normalize text files to LF in the repository.
* text=auto eol=lf

# These are executed on Linux and MUST have LF endings regardless of the
# platform they were edited on: a CRLF shebang (`#!/usr/bin/env bash\r`) makes
# the kernel look for an interpreter that does not exist, and systemd rejects
# unit files with trailing carriage returns.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
deploy/**       text eol=lf

# Python and web sources: LF everywhere.
*.py            text eol=lf
*.js            text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.md            text eol=lf
*.toml          text eol=lf
*.lock          text eol=lf

# Binary assets: never touched.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.db            binary
