# CryptoViz configuration.
#
# Copy to .env and adjust. Every value here has a working default, so an empty
# .env runs fine for local development.
#
#   cp .env.example .env

# --- Web server ------------------------------------------------------------

# Never enable debug on a public instance: it exposes an interactive console.
FLASK_DEBUG=false

# Development server bind address. In production gunicorn binds a unix socket
# instead (see deploy/gunicorn.conf.py) and these are unused.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Origins allowed to call /api/*. The frontend is same-origin, so this only
# matters if you want other sites to consume the API. Narrow it or set it to
# your own domain if you do not want the API open.
CORS_ORIGINS=*

# --- Database --------------------------------------------------------------

# Path to the SQLite database file. The deployment scripts set this to
# /var/lib/cryptoviz/crypto.db; the default is a crypto.db in the project root.
CRYPTOVIZ_DB_PATH=

# Seconds a connection waits for a competing writer before giving up. The web
# and worker processes share this database, so leave headroom.
CRYPTOVIZ_DB_BUSY_TIMEOUT=30

# SQLite read tuning: bytes of the database to memory-map, and KiB of page
# cache per connection. Lower both on a memory-constrained instance; each
# gunicorn worker and the scraper hold their own cache.
CRYPTOVIZ_DB_MMAP_BYTES=268435456
CRYPTOVIZ_DB_CACHE_KIB=65536

# --- Scraper worker --------------------------------------------------------

# Seconds between scrape runs. Lowering these increases the chance of being
# rate-limited or blocked by the upstream sources.
CRYPTOVIZ_PRICE_INTERVAL=300
CRYPTOVIZ_SENTIMENT_INTERVAL=300
CRYPTOVIZ_TOP_GAINERS_INTERVAL=300

# How long collected data is kept, in days. The default keeps a full year so
# the charts can show long-range history. See docs/DEPLOYMENT.md for the disk
# this implies (roughly 1 GB/year all told).
CRYPTOVIZ_PRICE_RETENTION_DAYS=365
CRYPTOVIZ_SENTIMENT_RETENTION_DAYS=365
CRYPTOVIZ_TOP_GAINERS_RETENTION_DAYS=365

# --- Chart downsampling ----------------------------------------------------

# Windows longer than these (in days) are averaged into hourly, then daily,
# buckets in SQL before being charted. Without this a one-year view would try
# to plot ~105,000 points per symbol. Raise for finer long-range charts at the
# cost of slower queries and heavier responses.
CRYPTOVIZ_HOURLY_BUCKET_DAYS=7
CRYPTOVIZ_DAILY_BUCKET_DAYS=90

# --- Logging ---------------------------------------------------------------

# DEBUG, INFO, WARNING, ERROR.
CRYPTOVIZ_LOG_LEVEL=INFO
