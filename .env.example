# Flask server configuration
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Turso (libSQL / cloud SQLite) database credentials.
# Leave blank to use a local SQLite file (crypto.db) for development.
#   turso db show <db-name> --url
#   turso db tokens create <db-name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
